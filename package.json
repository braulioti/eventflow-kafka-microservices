{
  "name": "eventflow-kafka-microservices",
  "version": "0.0.1",
  "private": true,
  "description": "Event-driven microservices with Apache Kafka",
  "workspaces": [
    "shared",
    "services/*"
  ],
  "dependencies": {
    "@nestjs/platform-express": "^11.1.21"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start:order": "npm run start:dev -w order-service",
    "start:payment": "npm run start:dev -w payment-service",
    "start:stock": "npm run start:dev -w stock-service",
    "start:notification": "npm run start:dev -w notification-service",
    "start:dlq": "npm run start:dev -w dlq-service",
    "test": "npm run test --workspaces --if-present",
    "verify:order-kafka": "node scripts/verify-order-kafka-flow.mjs",
    "verify:payment-flow": "node scripts/verify-payment-full-flow.mjs",
    "docker:payment-instances": "bash scripts/up-payment-instances.sh",
    "docker:rebuild-services": "bash scripts/rebuild-eventflow-services.sh",
    "verify:payment-scale": "node scripts/verify-payment-consumer-scale.mjs",
    "kafka:partitions": "bash scripts/kafka-set-topic-partitions.sh",
    "verify:kafka-partitions": "node scripts/verify-kafka-partitions.mjs"
  }
}
