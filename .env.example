# EventFlow - local environment variables (copy to .env)
# Regras completas: docs/RULES.md

# ------------------------------------------------------------------------------
# Kafka brokers
# ------------------------------------------------------------------------------
# Host (npm run start:*)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Docker network (docker/services/docker-compose.yml)
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Topic bootstrap (kafka-init / kafka:partitions)
# KAFKA_TOPIC_PARTITIONS=3
# KAFKA_TOPIC_REPLICATION_FACTOR=1
# KAFKA_TOPIC_RETENTION_MS=604800000
# KAFKA_TOPIC_CLEANUP_POLICY=delete

# ------------------------------------------------------------------------------
# Kafka consumer (all services)
# ------------------------------------------------------------------------------
# KAFKA_FROM_BEGINNING=false
# KAFKA_CONNECTION_TIMEOUT_MS=10000
# KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
# KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=3000
# KAFKA_CONSUMER_GROUP_SUFFIX=
# Mesmo groupId em TODAS as réplicas payment:
# KAFKA_CONSUMER_GROUP_PAYMENT_SERVICE=eventflow.payment-service

# ------------------------------------------------------------------------------
# HTTP ports
# ------------------------------------------------------------------------------
ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002

# Docker: payment-service horizontal scale (scripts/up-payment-instances.sh)
# PAYMENT_DOCKER_MODE=named
# PAYMENT_SERVICE_REPLICAS=2

STOCK_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
DLQ_SERVICE_PORT=3005

# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
ORDER_DATABASE_PATH=./services/order-service/data/orders.sqlite

# payment-service idempotency (Docker: volume payment-idempotency → /data/payments.sqlite)
PAYMENT_DATABASE_PATH=./services/payment-service/data/payments.sqlite

# ------------------------------------------------------------------------------
# Kafka retry — use NUMBERS or OMIT; never leave empty (KAFKA_RETRY_MAX_ATTEMPTS=)
# ------------------------------------------------------------------------------
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_BASE_DELAY_MS=1000
KAFKA_RETRY_MAX_DELAY_MS=30000
KAFKA_RETRY_BACKOFF_MULTIPLIER=2

# Consumer-only overrides (optional; fall back to KAFKA_RETRY_*)
# KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3
# KAFKA_CONSUMER_RETRY_BASE_DELAY_MS=1000
# KAFKA_CONSUMER_RETRY_MAX_DELAY_MS=30000
# KAFKA_CONSUMER_RETRY_BACKOFF_MULTIPLIER=2

# Producer-only overrides (optional; fall back to KAFKA_RETRY_*)
# KAFKA_PRODUCER_RETRY_MAX_ATTEMPTS=3
# KAFKA_PRODUCER_RETRY_BASE_DELAY_MS=1000
# KAFKA_PRODUCER_RETRY_MAX_DELAY_MS=30000
# KAFKA_PRODUCER_RETRY_BACKOFF_MULTIPLIER=2

# ------------------------------------------------------------------------------
# payment-service simulation (~80% approved, ~20% failed)
# ------------------------------------------------------------------------------
PAYMENT_FAILURE_RATE=0.2
# PAYMENT_FORCE_FAILURE=true
# PAYMENT_TIMEOUT_DELAY_MS=3000
# PAYMENT_MIN_AMOUNT=0.01
# PAYMENT_MAX_AMOUNT=10000
# PAYMENT_MAX_ITEMS=50
# PAYMENT_AMOUNT_TOLERANCE=0.01

# ------------------------------------------------------------------------------
# Verification scripts (optional)
# ------------------------------------------------------------------------------
# KAFKA_PAYMENT_CONSUMER_GROUP=eventflow.payment-service-server
# ORDER_SERVICE_URL=http://localhost:3001
# PAYMENT_SCALE_MIN_MEMBERS=2
